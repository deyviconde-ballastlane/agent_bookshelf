<% if (books.length === 0) { %>
  <div class="search-message"><p>No books found.</p></div>
<% } else { %>
  <div class="book-grid">
    <% books.forEach(book => { %>
      <div class="book-card">
        <h2><a href="/books/<%= book.id %>"><%= book.title %></a></h2>
        <p class="author">by <%= book.author %></p>
        <% if (book.published_year) { %>
          <p class="year"><%= book.published_year %></p>
        <% } %>
      </div>
    <% }) %>
  </div>
<% } %>
